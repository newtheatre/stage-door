# Copy to .env: see docs/development.md. Never commit .env.

# Session seal secret. Any 32+ char string in dev. Leave the line commented
# out and nuxt-auth-utils generates one into .env on first `bun run dev`.
# an empty value does NOT trigger generation and breaks session sealing.
# Production: worker secret, shared estate-wide: see docs/operations.md.
# NUXT_SESSION_PASSWORD=

# Leave unset in dev: emails are logged to the console instead of sent.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=

# The "NNT Auth (dev)" OAuth client (Phase 2: Google SSO). Redirect URI
# http://localhost:3000/auth/google. See docs/development.md#google-oauth-in-dev.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
