// Standalone config for `wrangler d1 migrations` against the production
// auth DB (docs/operations.md#deployments). The build-generated config in
// .output/server resolves its migrations_dir relative to itself and breaks
// when invoked directly: this one points at the source migrations.
//
//   npx wrangler d1 migrations list auth --remote -c wrangler.d1.jsonc
//   npx wrangler d1 migrations apply auth --remote -c wrangler.d1.jsonc
{
  "name": "stage-door",
  "compatibility_date": "2025-07-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auth",
      "database_id": "6b5be553-53e1-4eb2-b027-6fc11f9fe8f4",
      "migrations_table": "_hub_migrations",
      "migrations_dir": "server/db/migrations/sqlite"
    }
  ]
}
